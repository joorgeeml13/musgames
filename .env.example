# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
# ==============================================================================

# --- PostgreSQL Database ---
POSTGRES_DB=mus_db
POSTGRES_USER=mus_user
# Set a strong, randomly generated password in your local .env (never commit real passwords)
POSTGRES_PASSWORD=change_me_to_a_secure_database_password_in_prod
POSTGRES_PORT=5432

# --- Backend Application ---
BACKEND_PORT=8080

# --- Frontend Application ---
# FRONTEND_PORT: Local development server port (Vite)
FRONTEND_PORT=5173
# PROD_FRONTEND_PORT: Host port exposed in production mode (Nginx)
PROD_FRONTEND_PORT=80

# --- Vite Client Endpoints ---
# Exposed to client application during build/runtime
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_BASE_URL=ws://localhost:8080

# --- Security & Authentication ---
# Secret key used for JWT signing and verification (must be random, minimum 32 characters)
JWT_SECRET=change_me_to_a_cryptographically_secure_random_jwt_secret_min_32_chars
