# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
# ==============================================================================

# --- PostgreSQL Database ---
POSTGRES_DB=mus_db
POSTGRES_USER=mus_user
# Set a strong, randomly generated password in your local .env (never commit real passwords)
POSTGRES_PASSWORD=change_me_to_a_secure_database_password_in_prod
POSTGRES_PORT=5432

# --- RabbitMQ Message Broker ---
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=mus_user
# Set a strong, randomly generated password in production (never commit real passwords)
RABBITMQ_PASSWORD=change_me_to_a_secure_rabbitmq_password_in_prod

# --- Redis Distributed Cache ---
REDIS_PORT=6379

# --- Backend Application ---
BACKEND_PORT=8080

# --- Frontend Application ---
# FRONTEND_PORT: Local development server port (Vite)
FRONTEND_PORT=5173
# PROD_FRONTEND_PORT: Host port exposed in production mode (Nginx)
PROD_FRONTEND_PORT=80

# --- Vite Client Endpoints ---
# Exposed to client application during build/runtime
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_BASE_URL=ws://localhost:8080

# --- Domain & Reverse Proxy (Caddy / Cloudflare) ---
# Production apex domain name
DOMAIN_NAME=ordago.es
# ACME registration email for automatic TLS certificate issuance (Let's Encrypt / ZeroSSL)
ACME_EMAIL=admin@ordago.es
# HTTP Basic Authentication credentials for protected admin subdomains (cron, rabbit)
BASIC_AUTH_USER=admin
# Password hash for basic_auth generated with Caddy's bcrypt utility.
# Generate hash using:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<tu_contraseña>'
# Note: When using docker compose, escape each '$' in the bcrypt hash as '$$' in the .env file
# (e.g., $$2a$$14$$... instead of $2a$14$...) so Docker Compose does not interpret them as variables.
BASIC_AUTH_HASH=$$2a$$14$$JDJhJDE0JEVrTlpnUGwyLi4uLi4uLi4uLi4uLi4uLi4uLi4uLi4uLi4uLi4uLi4uLi4

# --- CORS Allowed Origins ---
# Comma-separated list of allowed origins for Quarkus REST endpoints
CORS_ALLOWED_ORIGINS=https://app.ordago.es

# --- Security & Authentication ---
# Secret key used for JWT signing and verification (must be random, minimum 32 characters)
JWT_SECRET=change_me_to_a_cryptographically_secure_random_jwt_secret_min_32_chars
# Shared secret for internal housekeeping/cron maintenance endpoints (session purge).
# Transmitted via mandatory X-Housekeeping-Key header; must be random and minimum 32 characters.
HOUSEKEEPING_API_KEY=change_me_to_a_cryptographically_secure_random_housekeeping_key_min_32_chars

# --- Cron & Job Scheduler (Dkron) ---
# Dkron web UI and HTTP API port (bound to 127.0.0.1 in dev; internal-only in prod)
DKRON_PORT=8998

# --- Observability Stack (Dev) ---
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200
GRAFANA_PORT=3000
# WARNING: 'admin/admin' credentials must never be used outside local loopback / in production.
GRAFANA_ADMIN_USER=admin
# WARNING: 'admin/admin' credentials must never be used outside local loopback / in production. Set a secure password for any non-local deployment.
GRAFANA_ADMIN_PASSWORD=admin
