{
  "name": "guest-housekeeping-purge",
  "schedule": "0 0 4 * * *",
  "timezone": "Europe/Madrid",
  "concurrency": "forbid",
  "executor": "http",
  "executor_config": {
    "method": "POST",
    "url": "http://backend:8080/api/v1/system/housekeeping/guests/purge",
    "headers": "[\"X-Housekeeping-Key: ${HOUSEKEEPING_API_KEY:-ordago-dev-housekeeping-secret-key-32chars}\", \"Content-Type: application/json\"]",
    "timeout": "60s"
  }
}
